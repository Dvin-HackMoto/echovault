# Copy to .env and adjust. Paths are relative to backend/.

# SQLite database file and photo folder (both under the git-ignored storage/)
DB_PATH=storage/echovault.db
PHOTO_DIR=storage/photos

# Local Ollama server and the model pulled with `ollama pull <model>`
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b

# faster-whisper model size (tiny | base | small | medium)
WHISPER_MODEL=small
